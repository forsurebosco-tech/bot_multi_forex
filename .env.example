# ---- OANDA ----
# Token from your OANDA Account Management Portal ("Manage API Access")
OANDA_API_TOKEN=your-oanda-api-token
OANDA_ACCOUNT_ID=your-account-id
# practice (demo, default) or live
OANDA_ENVIRONMENT=practice
# optional override; defaults to api-fxpractice.oanda.com / api-fxtrade.oanda.com based on environment
# OANDA_BASE_URL=https://api-fxpractice.oanda.com

# ---- Telegram ----
# Bot token from @BotFather and the chat id to send signals to (use @userinfobot or your own chat)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id